---
/**
 * Original pixel-art marks on a 12×12 grid, drawn as SVG rects with
 * crisp edges. Two tones from a single color: `main` rects at full
 * opacity, `soft` rects at reduced opacity (layering over main reads as
 * shading). Icons inherit `currentColor`, so they tint phosphor-green
 * inside `.night` and amber elsewhere automatically. Decorative only —
 * hidden from assistive tech.
 */
import type { PixelIconName } from '../lib/icons';

interface Props {
  name: PixelIconName;
  class?: string;
}

type Rects = [x: number, y: number, w: number, h: number][];

const ICONS: Record<PixelIconName, { main: Rects; soft: Rects }> = {
  // grass-block face: dirt body, lighter turf band with a jagged edge
  'voxel-block': {
    main: [[1, 4, 10, 7]],
    soft: [
      [1, 1, 10, 3],
      [2, 4, 2, 1],
      [7, 4, 1, 1],
    ],
  },
  // faceted gem: emerald-cut table, tapering pavilion, corner glint
  gem: {
    main: [
      [2, 3, 8, 2],
      [3, 5, 6, 2],
      [4, 7, 4, 2],
      [5, 9, 2, 2],
    ],
    soft: [
      [2, 1, 8, 2],
      [0, 0, 1, 1],
      [11, 3, 1, 1],
    ],
  },
  // chunky five-point star
  'star-bolt': {
    main: [
      [5, 0, 2, 2],
      [4, 2, 4, 1],
      [0, 3, 12, 1],
      [1, 4, 10, 1],
      [2, 5, 8, 1],
      [3, 6, 6, 1],
      [2, 7, 3, 1],
      [7, 7, 3, 1],
      [1, 8, 3, 1],
      [8, 8, 3, 1],
      [0, 9, 3, 1],
      [9, 9, 3, 1],
    ],
    soft: [[5, 4, 2, 2]],
  },
  // microwave with a phone resting on top
  microwave: {
    main: [
      [8, 0, 3, 2],
      [0, 2, 12, 8],
      [1, 10, 2, 1],
      [9, 10, 2, 1],
    ],
    soft: [
      [1, 3, 7, 6],
      [9, 4, 2, 1],
      [9, 6, 2, 1],
    ],
  },
  // basement key: ring bow, stem, two teeth
  key: {
    main: [
      [3, 1, 4, 1],
      [2, 2, 1, 3],
      [7, 2, 1, 3],
      [3, 5, 4, 1],
      [5, 6, 2, 5],
      [7, 8, 2, 1],
      [7, 10, 2, 1],
    ],
    soft: [[3, 2, 1, 1]],
  },
  // bold plus with corner burst ticks
  'plus-ultra': {
    main: [
      [4, 1, 4, 10],
      [1, 4, 10, 4],
    ],
    soft: [
      [1, 1, 1, 1],
      [10, 1, 1, 1],
      [1, 10, 1, 1],
      [10, 10, 1, 1],
    ],
  },
  // controller: body, grips, d-pad, button diamond
  gamepad: {
    main: [
      [1, 3, 10, 5],
      [0, 6, 2, 3],
      [10, 6, 2, 3],
    ],
    soft: [
      [3, 4, 1, 3],
      [2, 5, 3, 1],
      [8, 4, 1, 1],
      [7, 5, 1, 1],
      [9, 5, 1, 1],
      [8, 6, 1, 1],
    ],
  },
  // CRT television: V antenna, body, screen, knobs, feet
  'crt-tv': {
    main: [
      [2, 0, 1, 1],
      [9, 0, 1, 1],
      [3, 1, 1, 2],
      [8, 1, 1, 2],
      [1, 3, 10, 7],
      [3, 10, 1, 1],
      [8, 10, 1, 1],
    ],
    soft: [
      [2, 4, 6, 5],
      [9, 5, 1, 1],
      [9, 7, 1, 1],
    ],
  },
};

const { name, class: className } = Astro.props;
const icon = ICONS[name];
---

<svg viewBox="0 0 12 12" shape-rendering="crispEdges" class={className} fill="currentColor" aria-hidden="true">
  {icon.main.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
  {icon.soft.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} opacity="0.45" />)}
</svg>
