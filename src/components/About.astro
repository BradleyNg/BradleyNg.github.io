---
import fs from 'node:fs';
import path from 'node:path';
import Section from './Section.astro';
import { credentials, profile, sections } from '../lib/content';
import { withBase } from '../lib/url';
import { Content as AboutProse, frontmatter } from '../content/about.md';

interface Props {
  index: number;
}
const { index } = Astro.props;

// Optional headshot slots into the ID card; otherwise the photo well shows
// the same "awaiting capture" treatment as project figures.
const photo: string = frontmatter?.photo ?? '';
const photoAlt: string = frontmatter?.photoAlt ?? '';
const hasPhoto = photo !== '' && fs.existsSync(path.join(process.cwd(), 'public', photo));
const affiliation = credentials.education[0]?.institution ?? profile.headline;
---

<Section id="about" index={index} {...sections.about}>
  <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_17rem] md:gap-14">
    <div class="about-prose max-w-[46rem]" data-reveal>
      <AboutProse />
    </div>

    <aside
      class="device self-start border border-line-strong bg-surface p-5 text-ink backdrop-blur-[5px]"
      data-reveal
      style="--reveal-delay: 100ms"
    >
      <p class="flex items-center justify-between font-mono text-[0.65rem] uppercase tracking-[0.2em] text-faint">
        <span>Profile</span>
        <span class="glow-text text-accent">B;N</span>
      </p>
      <div class="mt-4 border border-line bg-inset">
        {
          hasPhoto ? (
            <img src={withBase(photo)} alt={photoAlt} class="aspect-square w-full object-cover" loading="lazy" />
          ) : (
            <div class="figure-grid relative aspect-square" role="img" aria-label="Placeholder — no ID photo yet">
              <span class="absolute left-1.5 top-1 font-mono text-[0.625rem] text-faint" aria-hidden="true">+</span>
              <span class="absolute right-1.5 top-1 font-mono text-[0.625rem] text-faint" aria-hidden="true">+</span>
              <p class="absolute inset-0 grid place-items-center px-4 text-center font-mono text-[0.625rem] uppercase tracking-[0.18em] text-faint">
                photo — awaiting capture
              </p>
            </div>
          )
        }
      </div>
      <dl class="mt-4 space-y-2.5 font-mono text-xs leading-relaxed">
        <div class="flex justify-between gap-3">
          <dt class="uppercase text-faint">Name</dt>
          <dd class="text-right">{profile.name}</dd>
        </div>
        <div class="flex justify-between gap-3">
          <dt class="uppercase text-faint">School</dt>
          <dd class="text-right">{affiliation}</dd>
        </div>
        <div class="flex justify-between gap-3">
          <dt class="uppercase text-faint">Base</dt>
          <dd class="text-right">{profile.location}</dd>
        </div>
        {
          profile.availability && (
            <div class="flex justify-between gap-3">
              <dt class="uppercase text-faint">Status</dt>
              <dd class="glow-text text-accent">● {profile.availability}</dd>
            </div>
          )
        }
      </dl>
      <div class="mt-4 border-t border-line pt-3" aria-hidden="true">
        <div
          class="h-3.5 w-full opacity-70"
          style="background: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 5px, var(--ink) 5px 6px, transparent 6px 10px, var(--ink) 10px 13px, transparent 13px 16px)"
        >
        </div>
      </div>
    </aside>
  </div>
</Section>
