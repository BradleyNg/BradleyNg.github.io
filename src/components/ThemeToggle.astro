---
// World-line switch. The label names the world line the meter is reading:
// light = the α attractor field (0.571024), dark = the Steins;Gate line
// (1.048596) — which lies beyond both attractor fields, so it is never
// labelled β. Flipping it fires a brief "Reading Steiner" flash, skipped
// entirely under prefers-reduced-motion.
---

<button
  id="theme-toggle"
  type="button"
  class="flex h-11 items-center gap-2 border border-line px-2.5 text-muted transition-colors hover:border-line-strong hover:text-ink"
  aria-label="Switch world line (color theme)"
>
  <svg class="icon-sun h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
    <circle cx="8" cy="8" r="3.2"></circle>
    <path d="M8 .8v2M8 13.2v2M15.2 8h-2M2.8 8h-2M13.1 2.9l-1.4 1.4M4.3 11.7l-1.4 1.4M13.1 13.1l-1.4-1.4M4.3 4.3 2.9 2.9"></path>
  </svg>
  <svg class="icon-moon h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
    <path d="M13.5 9.8A6 6 0 0 1 6.2 2.5a6 6 0 1 0 7.3 7.3Z"></path>
  </svg>
  <span class="font-mono text-[0.6875rem] tracking-wide" aria-hidden="true">
    <span class="wl-alpha">WL:α</span><span class="wl-beta">WL:S;G</span>
  </span>
</button>

<style>
  .icon-moon,
  .wl-beta {
    display: none;
  }
  :global([data-theme='dark']) .icon-moon {
    display: block;
  }
  :global([data-theme='dark']) .wl-beta {
    display: inline;
  }
  :global([data-theme='dark']) .icon-sun,
  :global([data-theme='dark']) .wl-alpha {
    display: none;
  }
</style>

<script>
  const button = document.getElementById('theme-toggle');
  const flash = document.getElementById('wl-flash');
  button?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    if (flash) {
      flash.classList.remove('wl-flash-run');
      void flash.offsetWidth; // restart the animation
      flash.classList.add('wl-flash-run');
    }
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {}
    // A world line changed — anything listening (the divergence meter)
    // gets to react.
    window.dispatchEvent(new CustomEvent('wl-shift'));
  });
</script>
