---
import Section from './Section.astro';
import { credentials, sections, skills } from '../lib/content';

interface Props {
  index: number;
}
const { index } = Astro.props;
---

<Section id="credentials" index={index} {...sections.credentials}>
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
    <div class="space-y-9 lg:col-span-7">
      {
        skills.map((group) => (
          <div data-reveal>
            <h3 class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.2em] text-faint">
              {group.label} <span class="text-accent">/ {String(group.items.length).padStart(2, '0')}</span>
            </h3>
            <ul class="mt-3.5 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="border border-line bg-raised px-3 py-1.5 font-mono text-[0.8125rem] text-muted">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="space-y-6 lg:col-span-5">
      {
        credentials.education.map((edu) => (
          <div class="border border-line bg-raised p-6 backdrop-blur-[5px]" data-reveal>
            <p class="kicker">Education</p>
            <h3 class="font-display mt-3 text-xl font-medium">{edu.institution}</h3>
            <p class="mt-1 text-sm text-muted">{edu.credential}</p>
            <p class="mt-2.5 font-mono text-xs text-accent">
              {edu.timeframe}
              {edu.location && <span class="text-faint"> · {edu.location}</span>}
            </p>
            {edu.coursework.length > 0 && (
              <p class="mt-4 border-t border-line pt-4 font-mono text-xs leading-relaxed text-faint">
                <span class="uppercase tracking-[0.14em]">Coursework</span> — {edu.coursework.join(' · ')}
              </p>
            )}
          </div>
        ))
      }

      <div class="border border-line bg-raised p-6 backdrop-blur-[5px]" data-reveal style="--reveal-delay: 90ms">
        <p class="kicker">Certifications & Awards</p>
        <ul class="mt-2">
          {
            credentials.certifications.map((cert) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-line py-3">
                <span class="text-sm">{cert.name}</span>
                <span class="shrink-0 font-mono text-xs text-faint">
                  {cert.issuer}
                  {cert.year && ` · ${cert.year}`}
                </span>
              </li>
            ))
          }
          {
            credentials.awards.map((award) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-line py-3 last:border-b-0">
                <span class="text-sm">
                  <span class="mr-1.5 text-accent-bright" aria-hidden="true">✶</span>
                  {award.name}
                </span>
                <span class="shrink-0 font-mono text-xs text-faint">
                  {award.issuer}
                  {award.detail && ` · ${award.detail}`}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Section>
