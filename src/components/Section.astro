---
interface Props {
  id: string;
  index: number; // section number, rendered inline as "01." before the title
  navLabel: string; // used by the nav; accepted here so sections.json entries can be spread in
  title: string;
  subtitle?: string | undefined;
  class?: string;
}

const { id, index, title, subtitle, class: className } = Astro.props;
const number = String(index).padStart(2, '0');
---

{/* extra scroll margin on small screens clears the two-row mobile header */}
<section id={id} class:list={['scroll-mt-28 md:scroll-mt-16', className]} aria-labelledby={`${id}-title`}>
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <header class="mb-10 md:mb-12" data-reveal>
      <h2
        id={`${id}-title`}
        class="font-display text-[1.625rem] font-semibold uppercase leading-tight tracking-[0.01em] md:text-[2rem]"
      >
        <span class="glow-text mr-3 font-mono text-[0.8em] font-medium tabular-nums text-accent" aria-hidden="true">{number}.</span>{title}
      </h2>
      {subtitle && <p class="mt-3 max-w-[44rem] text-[0.9375rem] leading-relaxed text-muted">{subtitle}</p>}
      <div class="mt-5 h-px w-16 bg-accent-bright" aria-hidden="true"></div>
    </header>
    <slot />
  </div>
</section>
