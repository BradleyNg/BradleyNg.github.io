---
/**
 * A nixie-tube numeral display — the divergence meter. Built entirely from
 * CSS (no images): dark glass tubes, anode mesh, unlit cathode ghosts, and
 * glowing digits in the Nixie One face. With `scramble`, the digits spin down
 * and settle left-to-right the first time the meter scrolls into view, and
 * again on every world-line shift (disabled under prefers-reduced-motion).
 *
 * `defer` hands the first roll to whoever owns the reveal (the hero times it
 * against its entrance) instead of firing as soon as the tubes intersect —
 * otherwise the meter would spin while it is still faded out.
 */
interface Props {
  value: string; // digits and dots only, e.g. "1.048596"
  label?: string | undefined; // small caption under the tubes
  size?: string; // CSS font-size driving tube scale
  scramble?: boolean;
  defer?: boolean;
}

const { value, label, size = '3rem', scramble = false, defer = false } = Astro.props;
const chars = value.split('');
---

<div class="inline-block" role="img" aria-label={`Divergence meter reading ${value} — a Steins;Gate homage`}>
  <span
    class="nixie"
    data-value={value}
    data-scramble={scramble ? 'true' : undefined}
    data-defer={defer ? 'true' : undefined}
    style={`font-size: ${size}`}
    aria-hidden="true"
  >
    {
      chars.map((ch) =>
        ch === '.' ? (
          <span class="nixie-tube nixie-tube--dot">
            <span class="nixie-dot" />
          </span>
        ) : (
          <span class="nixie-tube">
            <span class="nixie-ghost">8</span>
            {/* prettier-ignore — kept on one line so the glyph carries no
                surrounding whitespace; the roll rewrites textContent and any
                padding would change the tube's width on first animation */}
            <span class="nixie-digit" data-final={ch}>{ch}</span>
          </span>
        )
      )
    }
  </span>
  {label && <p class="mt-3 font-mono text-[0.65rem] uppercase tracking-[0.26em] text-faint">{label}</p>}
</div>

<script>
  // Digits spin down and settle left-to-right: once when a meter first
  // appears, and again on every world-line shift (theme toggle).
  import { motionOK, rollDigits, whenVisible } from '../lib/motion';

  const ROLL_MS = 950;

  // The two hero meters (α and S;G) both exist; CSS shows only the one matching
  // the current theme. A meter that is not rendered must never roll — its
  // animation would run down while hidden, so revealing it later would show
  // digits that had already settled.
  const isShown = (el: HTMLElement) => el.getClientRects().length > 0;

  function roll(meter: HTMLElement) {
    const digits = [...meter.querySelectorAll<HTMLElement>('.nixie-digit')];
    if (digits.length > 0) rollDigits(digits, { duration: ROLL_MS, step: 55 });
  }

  // `?static=1` (no .js class) and reduced motion both leave the tubes on
  // their server-rendered values, matching the no-JS experience.
  if (motionOK()) {
    const meters = [...document.querySelectorAll<HTMLElement>('.nixie[data-scramble]')];

    for (const meter of meters) {
      // deferred meters wait for their owner to call the roll (see Hero)
      if (meter.dataset.defer !== 'true') whenVisible(meter, () => roll(meter), '0px');
    }
    window.addEventListener('nixie-roll', () => {
      meters.filter((m) => m.dataset.defer === 'true' && isShown(m)).forEach(roll);
    });
    // Every shift restarts the roll on whichever meter the new theme reveals.
    // There is deliberately no re-entrancy guard: pressing again mid-roll should
    // keep the digits flipping and settle them on the new reading, not snap
    // them to it.
    window.addEventListener('wl-shift', () => meters.filter(isShown).forEach(roll));
  }
</script>
