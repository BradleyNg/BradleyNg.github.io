---
import Section from './Section.astro';
import { experience, sections } from '../lib/content';
import { emphasize } from '../lib/text';

interface Props {
  index: number;
}
const { index } = Astro.props;
---

<Section id="experience" index={index} {...sections.experience}>
  {/* The rail is the observed world line; each role is a node on it. The
      current role's node glows. Dates render as scene-timestamp chips. */}
  <ol class="relative ml-1 border-l border-line-strong">
    {
      experience.map((job) => {
        const active = job.end.trim().toLowerCase() === 'present';
        return (
          <li
            class="relative grid gap-4 border-b border-line py-9 pl-6 last:border-b-0 md:grid-cols-[11.5rem_minmax(0,1fr)] md:gap-8 md:py-10 md:pl-9"
            data-reveal
          >
            <span class:list={['rail-node', active && 'rail-node--active']} aria-hidden="true" />
            <div class="font-mono text-xs leading-relaxed">
              <span class="stamp">
                {job.start} — {job.end}
              </span>
              <p class="mt-2.5 text-faint">{job.location}</p>
            </div>
            <div>
              <h3 class="font-display text-lg font-semibold md:text-[1.25rem]">{job.role}</h3>
              <p class="mt-1 font-mono text-[0.8125rem] text-muted">{job.org}</p>
              <ul class="mt-4 space-y-2.5">
                {job.bullets.map((bullet) => (
                  <li class="content-emphasis flex gap-3 text-[0.9375rem] leading-relaxed text-muted">
                    <span class="mt-[0.7em] h-px w-3.5 shrink-0 bg-accent-bright" aria-hidden="true" />
                    <span set:html={emphasize(bullet)} />
                  </li>
                ))}
              </ul>
              {job.tech.length > 0 && <p class="mt-4 font-mono text-xs leading-relaxed text-faint">{job.tech.join(' · ')}</p>}
            </div>
          </li>
        );
      })
    }
  </ol>
</Section>
