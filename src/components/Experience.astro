---
import Section from './Section.astro';
import { experience, sections } from '../lib/content';
import { emphasize } from '../lib/text';

interface Props {
  index: number;
}
const { index } = Astro.props;

// Placement is index-driven, so editing experience.json keeps working:
//   0        → lead, alone on the single line, spanning both columns
//   1, 3, 5… → left column, on the line that continues straight down
//   2, 4, 6… → right column, on the line that branches off
// Roles pair up by stage: stage 1 is roles 1–2, stage 2 is roles 3–4, …
const placement = experience.map((_, i) => ({
  track: i === 0 ? ('lead' as const) : i % 2 === 1 ? ('left' as const) : ('right' as const),
  stage: i === 0 ? 0 : Math.floor((i - 1) / 2) + 1,
  row: i === 0 ? 1 : Math.floor((i - 1) / 2) + 2,
}));
const lastIndex = experience.length - 1;
const forked = experience.length > 1;
---

<Section id="experience" index={index} {...sections.experience}>
  <div class="wl" data-fork="off" data-merge="off">
    {/* rails and junctions sit behind the roles; positions and heights come
        from the script below, which measures the cards once and on resize */}
    <span class="wl-rail wl-rail--lead" aria-hidden="true"></span>
    {
      forked && (
        <>
          <span class="wl-rail wl-rail--left" aria-hidden="true" />
          <span class="wl-rail wl-rail--right" aria-hidden="true" />
          {/* viewBox min-x stays 0 so a 50% origin resolves correctly */}
          <svg class="wl-fork" viewBox="0 0 200 80" preserveAspectRatio="none" fill="none" aria-hidden="true">
            <path d="M 0 0 L 0 16 L 200 56 L 200 80" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
          </svg>
          <svg class="wl-merge" viewBox="0 0 200 80" preserveAspectRatio="none" fill="none" aria-hidden="true">
            <path d="M 200 0 L 200 24 L 0 64 L 0 80" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
          </svg>
        </>
      )
    }

    <ol class="wl-list">
      {
        experience.map((job, i) => {
          const { track, stage, row } = placement[i]!;
          return (
            <li class:list={['wl-entry', `wl-entry--${track}`]} style={`grid-row: ${row}`} data-stage={stage} data-track={track}>
              <div class="wl-card">
                <div class="font-mono text-xs leading-relaxed">
                  <span class="stamp">
                    {job.start} — {job.end}
                  </span>
                  <p class="mt-2.5 text-faint">{job.location}</p>
                </div>
                <h3 class="font-display mt-5 text-lg font-semibold md:text-[1.3rem]">{job.role}</h3>
                <p class="mt-1 font-mono text-[0.8125rem] text-muted">{job.org}</p>
                <ul class="wl-bullets mt-5 space-y-2.5">
                  {job.bullets.map((bullet) => (
                    <li class="content-emphasis flex gap-3 text-[0.9375rem] leading-relaxed text-muted">
                      <span class="mt-[0.7em] h-px w-3.5 shrink-0 bg-accent-bright" aria-hidden="true" />
                      <span set:html={emphasize(bullet)} />
                    </li>
                  ))}
                </ul>
                {job.tech.length > 0 && <p class="mt-4 font-mono text-xs leading-relaxed text-faint">{job.tech.join(' · ')}</p>}
              </div>
            </li>
          );
        })
      }
    </ol>

    <span class="wl-orb wl-orb--lead" aria-hidden="true"></span>
    <span class="wl-orb wl-orb--left" aria-hidden="true"></span>
    <span class="wl-orb wl-orb--right" aria-hidden="true"></span>
  </div>
</Section>

<script>
  // Scroll-driven world lines. Each light tracks the reading line down its own
  // world line, and the rails are trails grown to wherever each light has
  // reached — so a set's line (and text) only exists once a light descends to
  // it. The right light follows an offset-path (the jogged route), so it
  // traverses the actual world line instead of cutting straight across.
  const wl = document.querySelector<HTMLElement>('.wl');
  const entries = wl ? [...wl.querySelectorAll<HTMLElement>('.wl-entry')] : [];
  const cards = entries.map((e) => e.querySelector<HTMLElement>('.wl-card')!);

  if (wl && cards.length > 0) {
    const orbLead = wl.querySelector<HTMLElement>('.wl-orb--lead')!;
    const orbLeft = wl.querySelector<HTMLElement>('.wl-orb--left')!;
    const orbRight = wl.querySelector<HTMLElement>('.wl-orb--right')!;
    const railRight = wl.querySelector<HTMLElement>('.wl-rail--right');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const forked = cards.length > 1;
    const stageOf = (i: number) => (i === 0 ? 0 : Math.floor((i - 1) / 2) + 1);

    const FORK_H = 80;
    const GAP = 30; // room under a card before its junction
    const READ = 0.42; // reading line, fraction of viewport height

    // Geometry in .wl-local pixels, remeasured on resize/load.
    let g = {
      top: 0, // document Y of .wl top
      leadStart: 0,
      forkY: 0,
      branchTop: 0,
      mergeTop: 0,
      mergeY: 0,
      rightX: 0,
      rightPath: [] as { x: number; y: number; len: number }[], // cumulative-length vertices
      rightLen: 0,
    };

    function measure() {
      g.top = wl!.getBoundingClientRect().top + window.scrollY;
      g.rightX = railRight ? railRight.offsetLeft : 0;
      const lead = cards[0]!;
      g.leadStart = lead.offsetTop + Math.min(46, lead.offsetHeight * 0.16);
      g.forkY = lead.offsetTop + lead.offsetHeight + GAP;
      g.branchTop = g.forkY + FORK_H;
      let bottom = g.branchTop;
      for (let i = 1; i < cards.length; i++) bottom = Math.max(bottom, cards[i]!.offsetTop + cards[i]!.offsetHeight);
      g.mergeTop = bottom + GAP;
      g.mergeY = g.mergeTop + FORK_H;

      wl!.style.setProperty('--wl-fork-y', `${g.forkY}px`);
      wl!.style.setProperty('--wl-fork-h', `${FORK_H}px`);
      wl!.style.setProperty('--wl-left-top', `${g.forkY}px`); // left line continues straight from the fork
      wl!.style.setProperty('--wl-branch-top', `${g.branchTop}px`);
      wl!.style.setProperty('--wl-merge-top', `${g.mergeTop}px`);

      // The right light's world line: down at x=0 to the fork, jog to the
      // centre, down the right line, jog back to x=0 at the merge.
      const rx = g.rightX;
      const pts = [
        { x: 0, y: g.forkY },
        { x: 0, y: g.forkY + 0.2 * FORK_H },
        { x: rx, y: g.forkY + 0.7 * FORK_H },
        { x: rx, y: g.branchTop },
        { x: rx, y: g.mergeTop },
        { x: rx, y: g.mergeTop + 0.3 * FORK_H },
        { x: 0, y: g.mergeTop + 0.8 * FORK_H },
        { x: 0, y: g.mergeY },
      ];
      let len = 0;
      g.rightPath = pts.map((p, i) => {
        if (i > 0) len += Math.hypot(p.x - pts[i - 1]!.x, p.y - pts[i - 1]!.y);
        return { x: p.x, y: p.y, len };
      });
      g.rightLen = len;
      orbRight.style.offsetPath = `path("${pts.map((p, i) => `${i ? 'L' : 'M'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ')}")`;
    }

    // offset-distance (%) for a point at world-line height y on the right path
    function rightDistPct(y: number) {
      const path = g.rightPath;
      const yy = Math.max(path[0]!.y, Math.min(path[path.length - 1]!.y, y));
      for (let i = 1; i < path.length; i++) {
        const a = path[i - 1]!;
        const b = path[i]!;
        if (yy <= b.y || i === path.length - 1) {
          const f = b.y === a.y ? 1 : (yy - a.y) / (b.y - a.y);
          const d = a.len + f * (b.len - a.len);
          return g.rightLen > 0 ? (d / g.rightLen) * 100 : 0;
        }
      }
      return 100;
    }

    let raf = 0;
    function frame() {
      raf = 0;
      // Below lg the fork is off; show every role plainly (single-column CSS).
      if (window.innerWidth < 1024) {
        entries.forEach((el) => (el.dataset.vis = 'active'));
        return;
      }
      const reading = window.scrollY + window.innerHeight * READ - g.top;

      // which single stage is in focus (used only for showing/hiding text)
      let activeStage = 0;
      for (let i = 1; i < cards.length; i++) {
        if (i % 2 === 1 && cards[i]!.offsetTop - 40 <= reading) activeStage = stageOf(i);
      }
      entries.forEach((el) => {
        el.dataset.vis = Number(el.dataset.stage) === activeStage ? 'active' : 'other';
      });

      // the single line runs top → fork; the lead light rides it to the fork
      const leadY = Math.max(g.leadStart, Math.min(reading, g.forkY));
      orbLead.style.setProperty('--wl-orb-lead-y', `${leadY}px`);
      wl!.style.setProperty('--wl-lead-h', `${Math.min(reading, g.forkY)}px`);

      const pair = forked && reading > g.forkY;
      wl!.dataset.fork = pair ? 'on' : 'off';
      wl!.dataset.merge = forked && reading > g.mergeTop - 4 ? 'on' : 'off';

      // Both branch lights start at the fork point and track the reading line
      // down their own world lines — the left straight down, the right jogging
      // to the centre — so the staggered roles make them arrive one after the
      // other. The rails are trails grown to wherever each light has reached.
      const branchY = Math.max(g.forkY, Math.min(reading, g.mergeY));
      orbLeft.style.setProperty('--wl-orb-left-y', `${branchY}px`);
      orbRight.style.setProperty('--wl-right-dist', `${rightDistPct(branchY)}%`);
      wl!.style.setProperty('--wl-left-h', `${Math.max(0, branchY - g.forkY)}px`);
      wl!.style.setProperty('--wl-right-h', `${Math.max(0, branchY - g.branchTop)}px`);

      // Hand-off: only one of {lead} / {left,right} is lit. The fade-in delay
      // in CSS lets the outgoing light clear the fork before the pair appears.
      orbLead.classList.toggle('is-on', !pair);
      orbLeft.classList.toggle('is-on', pair);
      orbRight.classList.toggle('is-on', pair);
    }

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };

    if (reduced || !forked) {
      // Static, fully readable: every set shown, a plain single rail.
      measure();
      entries.forEach((el) => (el.dataset.vis = 'active'));
      wl.style.setProperty('--wl-lead-h', `${g.mergeY || 9999}px`);
      if (forked) {
        wl.dataset.fork = 'on';
        wl.style.setProperty('--wl-left-h', `${g.mergeY - g.forkY}px`);
        wl.style.setProperty('--wl-right-h', `${g.mergeY - g.branchTop}px`);
      }
    } else {
      measure();
      frame();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener(
        'resize',
        () => {
          measure();
          frame();
        },
        { passive: true }
      );
      window.addEventListener('load', () => {
        measure();
        frame();
      });
    }
  }
</script>
