---
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/600.css';
import '@fontsource/chakra-petch/700.css';
import '@fontsource/chakra-petch/600-italic.css';
import '@fontsource/nixie-one';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Backdrop from '../components/Backdrop.astro';
import { profile } from '../lib/content';
import { withBase } from '../lib/url';

const title = `${profile.name} — ${profile.headline}`;
const description = profile.positioning;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f5f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0e11" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <script is:inline>
      // Runs before first paint: applies the saved/system theme (no flash)
      // and flags JS availability so scroll-reveal styles only apply with JS.
      // Debug/query overrides: ?theme=light|dark forces a theme for this
      // load; ?static=1 renders everything without entrance animations.
      (function () {
        var params = new URLSearchParams(window.location.search);
        var t = params.get('theme');
        if (t !== 'light' && t !== 'dark') {
          try {
            t = localStorage.getItem('theme');
          } catch (e) {}
        }
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
        if (!params.has('static')) document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <Backdrop />
    <div id="wl-flash" aria-hidden="true"></div>
    <a
      href="#main"
      class="fixed left-4 top-4 z-50 -translate-y-24 bg-accent-bright px-4 py-2 font-mono text-sm text-surface transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <slot />
    <script>
      // Scroll reveals — adds .is-revealed as elements enter the viewport.
      const revealables = document.querySelectorAll('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
      );
      revealables.forEach((el) => io.observe(el));

      console.log('%cEl. Psy. Kongroo.', 'font-family:monospace;color:#ff9d2e;');
    </script>
  </body>
</html>
